<Window x:Class="Ejercicio8.Ejercicio5"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ejercicio8"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <WrapPanel Orientation="Horizontal"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
            <Button Content="Click Event"
                    Padding="15,10"
                    Click="Button_Click" />
            <Button Content="Mouse Enter"
                    Padding="15,10"
                    MouseEnter="Button_MouseEnter" />
            <Button Content="Left Click Event"
                    Padding="15,10"
                    MouseRightButtonDown="Button_MouseRightButtonDown" />
        </WrapPanel>
    </Grid>
</Window>
