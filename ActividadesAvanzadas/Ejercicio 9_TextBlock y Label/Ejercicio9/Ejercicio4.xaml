<Window x:Class="Ejercicio9.Ejercicio4"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ejercicio9"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBlock Margin="10"
                   Foreground="Red"
                   FontSize="16"
                   TextWrapping="Wrap">
            Este es un texto principal en rojo que ocupa varias líneas sin cortarse gracias a TextWrapping.
            <LineBreak />
            <Run Foreground="Blue">Esta segunda línea es de color azul</Run> y contiene una palabra en
            <Bold>negrita</Bold> junto con otro fragmento en <Run Foreground="Green">color verde</Run>.
        </TextBlock>
    </Grid>
</Window>
