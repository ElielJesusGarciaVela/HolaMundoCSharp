<Window x:Class="HolaMundoWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HolaMundoWpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <TextBlock TextWrapping="Wrap" Text="Hola Mundo!" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="36" Height="50" Margin="0,33,0,0"/>
        <TextBlock TextWrapping="Wrap" Text="Hola Mundo Dos!" HorizontalAlignment="Center" VerticalAlignment="Top" FontSize="20" Margin="0,88,0,0" Width="162"/>
        <Button HorizontalAlignment="Center" VerticalAlignment="Top" Click="Button_Click" Margin="0,202,0,0">
            <WrapPanel>
                <TextBlock Foreground="Red">Hola</TextBlock>
                <TextBlock Foreground="Blue">Mundo</TextBlock>
            </WrapPanel>
        </Button>
        <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="577,93,0,0">
            <TextBlock TextWrapping="Wrap" Text="Hola Mundo Tres!" FontSize="20" Width="162"/>
            <ListBox Height="50" Width="120">
                <ListBoxItem Content="Listbox1 Item 1"/>
                <ListBoxItem Content="Listbox1 Item 2"/>
            </ListBox>
            <ListBox Height="50" Width="120">
                <ListBoxItem Content="Listbox2 Item 1"/>
                <ListBoxItem Content="Listbox2 Item 2"/>
            </ListBox>
            <ListBox Height="50" Width="120">
                <ListBoxItem Content="Listbox3 Item 1"/>
                <ListBoxItem Content="Listbox3 Item 2"/>
            </ListBox>
            <Button Click="Button_Click_1" Content="Click"/>
        </StackPanel>
    </Grid>
</Window>
